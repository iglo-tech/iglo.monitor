#!/bin/sh
# Pre-commit hook (fast gate, seconds): format staged files with oxfmt, then lint
# them with oxlint and stylelint. Lint errors block the commit; warnings do not.
# The full gate runs before push: see .githooks/pre-push and scripts/verify.sh.
#
# Prerequisites:
# - `bun install` so node_modules/.bin/oxfmt is present
# - Bun (discovered automatically; override with BUN_BIN if needed)
# - perl (for null-delimited staged-file filtering)
#
# Limitations:
# - Formats entire files, then re-stages them with `git add`. Partial staging
#   (git add -p) is not preserved: unstaged hunks are folded into the index.
# - Ignore-path rules mirror .oxfmtrc.json ignorePatterns; keep them in sync.
set -eu

root=$(git rev-parse --show-toplevel)
cd "$root"

oxfmt_cli="$root/node_modules/.bin/oxfmt"
if [ ! -f "$oxfmt_cli" ]; then
    echo "Error: oxfmt not found. Run 'bun install' in the repository root." >&2
    exit 1
fi

. "$root/.githooks/lib.sh"

bun=$(find_bun) || {
    echo "Error: bun not found. Install Bun (https://bun.sh) or set BUN_BIN to the bun executable." >&2
    exit 1
}

list_file=$(mktemp)
trap 'rm -f "$list_file"' EXIT INT TERM

# Ignore rules must stay aligned with ignorePatterns in .oxfmtrc.json.
git diff --cached --name-only -z --diff-filter=ACMR | perl -0ne '
    for my $file (split(/\0/, $_, -1)) {
        next if $file eq "";
        next unless $file =~ /\.(js|ts|vue|css|scss|json|md|yml|yaml)$/i;
        next if $file =~ m{(?:^|/)(?:node_modules|dist|dist-ssr|private|out|tmp)(?:/|$)};
        next if $file =~ m{(?:^|/)data[^/]*(?:/|$)};
        print "$file\0";
    }
' > "$list_file"

if [ ! -s "$list_file" ]; then
    exit 0
fi

xargs -0 "$bun" "$oxfmt_cli" --write < "$list_file"
xargs -0 git add -- < "$list_file"

# Lint the staged files that the linters cover. Paths ignored by .gitignore or
# .oxlintrc.json are skipped by the linters themselves.
js_list=$(mktemp)
css_list=$(mktemp)
trap 'rm -f "$list_file" "$js_list" "$css_list"' EXIT INT TERM
perl -0ne 'for my $f (split(/\0/, $_, -1)) { print "$f\0" if $f =~ /\.(js|ts|vue)$/i }' < "$list_file" > "$js_list"
perl -0ne 'for my $f (split(/\0/, $_, -1)) { print "$f\0" if $f =~ /\.(vue|css|scss)$/i }' < "$list_file" > "$css_list"

if [ -s "$js_list" ]; then
    xargs -0 "$bun" "$root/node_modules/.bin/oxlint" --config ./.oxlintrc.json --ignore-path .gitignore --quiet < "$js_list" || {
        echo "pre-commit: oxlint found errors in staged files. Fix them, or run 'bun run lint:js:fix'." >&2
        exit 1
    }
fi
if [ -s "$css_list" ]; then
    xargs -0 "$bun" "$root/node_modules/.bin/stylelint" --ignore-path .gitignore --allow-empty-input < "$css_list" || {
        echo "pre-commit: stylelint found errors in staged files. Fix them, or run 'bun run lint:style:fix'." >&2
        exit 1
    }
fi