{
    "name": "iglo.monitor",
    "description": "A lightweight, self-hosted monitoring application built on Bun.",
    "version": "1.0.0-beta.3",
    "type": "module",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/iglo-tech/iglo.monitor.git"
    },
    "homepage": "https://iglo.tech",
    "engines": {
        "bun": ">= 1.4.0"
    },
    "scripts": {
        "dev": "bun run --parallel dev:frontend dev:server",
        "dev:frontend": "NODE_ENV=development vite --host --config ./config/vite.config.ts",
        "dev:frontend:container": "NODE_ENV=development DEVCONTAINER=1 vite --host --config ./config/vite.config.ts",
        "dev:server": "NODE_ENV=development bun src/server/server.ts",
        "dev:server:watch": "NODE_ENV=development bun --watch src/server/server.ts",
        "start": "bun src/server/server.ts",
        "build": "bun scripts/build/generate-kuma-db.ts && bun scripts/build/build-binary.ts",
        "build:kuma-db": "bun scripts/build/generate-kuma-db.ts",
        "build:frontend": "bun --bun vite build --config ./config/vite.config.ts && bun scripts/build/generate-embedded-assets.ts",
        "build:frontend:analyze": "ANALYZE=1 bun run build:frontend",
        "build:binary": "bun scripts/build/build-binary.ts",
        "preview": "vite preview --host --config ./config/vite.config.ts",
        "lint": "bun run lint:js && bun run lint:style",
        "lint:fix": "bun run lint:js:fix && bun run lint:style:fix",
        "lint:js": "oxlint --config ./.oxlintrc.json --ignore-path .gitignore .",
        "lint:js:fix": "oxlint --config ./.oxlintrc.json --ignore-path .gitignore --fix .",
        "lint:style": "stylelint \"**/*.{vue,css,scss}\" --ignore-path .gitignore",
        "lint:style:fix": "stylelint \"**/*.{vue,css,scss}\" --fix --ignore-path .gitignore",
        "fmt": "oxfmt \"**/*.{js,ts,vue,css,scss,json,md,yml,yaml}\"",
        "hooks:install": "sh scripts/install-git-hooks.sh",
        "tsc": "tsc --project ./tsconfig-backend.json",
        "audit": "bun audit",
        "test": "bun run test:backend && bun run test-e2e",
        "test-with-build": "bun run build:frontend && bun run test:backend",
        "test:backend": "bun run test:backend:unit && bun run test:auth-security && bun run test:maintenance",
        "test:backend:unit": "bun test ./test/backend-test/analytics-scripts.test.ts ./test/backend-test/badge-renderer.test.ts ./test/backend-test/composition-root.test.ts ./test/backend-test/domain.test.ts ./test/backend-test/frontend-entry-assets.test.ts ./test/backend-test/heartbeat-data-plane.test.ts ./test/backend-test/auth-security-metrics-benchmark.test.ts ./test/backend-test/auth-settings-injection.test.ts ./test/backend-test/sqlite-core.test.ts ./test/backend-test/bun-websocket-server.test.ts ./test/backend-test/db-lifecycle-injection.test.ts ./test/backend-test/cert-hostname-match.test.ts ./test/backend-test/check-translations.test.ts ./test/backend-test/gamedig-map.test.ts ./test/backend-test/globalping.test.ts ./test/backend-test/http-client.test.ts ./test/backend-test/import-boundaries.test.ts ./test/backend-test/maintenance.test.ts ./test/backend-test/monitor-conditions/evaluator.test.ts ./test/backend-test/monitor-conditions/expressions.test.ts ./test/backend-test/monitor-lifecycle.test.ts ./test/backend-test/monitor-numeric-validation.test.ts ./test/backend-test/monitor-provider-timeout.test.ts ./test/backend-test/optional-startup-integrations.test.ts ./test/backend-test/prometheus.test.ts ./test/backend-test/real-browser-monitor-lifecycle.test.ts ./test/backend-test/monitor-response.test.ts ./test/backend-test/monitor-runtime-loading.test.ts ./test/backend-test/oauth-client-credentials.test.ts ./test/backend-test/runtime-registry-callsite.test.ts ./test/backend-test/monitor-scheduler.test.ts ./test/backend-test/monitors/gamedig.test.ts ./test/backend-test/monitors/grpc.test.ts ./test/backend-test/monitors/steam.test.ts ./test/backend-test/monitors/tcp.test.ts ./test/backend-test/monitors/websocket.test.ts ./test/backend-test/native-utils.test.ts ./test/backend-test/notification-provider-loading.test.ts ./test/backend-test/notification-provider-metadata.test.ts ./test/backend-test/notification-providers/notification-provider.test.ts ./test/backend-test/ping-chart.test.ts ./test/backend-test/proxy-validation.test.ts ./test/backend-test/radius.test.ts ./test/backend-test/schema.test.ts ./test/backend-test/startup-memory-harness.test.ts ./test/backend-test/status-page.test.ts ./test/backend-test/system-service.test.ts ./test/backend-test/upgrade.test.ts ./test/backend-test/uptime-calculator.test.ts ./test/backend-test/user-resources-injection.test.ts ./test/backend-test/util.test.ts",
        "test:backend:all": "bun test ./test/backend-test",
        "test:auth-security": "bun test ./test/integration-test/auth-security.test.ts",
        "test:maintenance": "bun test ./test/integration-test/maintenance.test.ts",
        "test:auth-security-binary": "bun test ./test/integration-test/auth-security.test.ts",
        "test:notification-provider-binary": "bun test ./test/integration-test/notification-provider-binary.test.ts",
        "test-e2e": "playwright test --config ./config/playwright.config.ts",
        "test-e2e-ui": "playwright test --config ./config/playwright.config.ts --ui --ui-port=51063",
        "playwright-codegen": "playwright codegen localhost:3000 --save-storage=./private/e2e-auth.json",
        "playwright-show-report": "playwright show-report ./private/playwright-report",
        "reset-password": "bun scripts/admin/reset-password.ts",
        "remove-2fa": "bun scripts/admin/remove-2fa.ts",
        "simple-dns-server": "bun scripts/dev/simple-dns-server.ts",
        "simple-mqtt-server": "bun scripts/dev/simple-mqtt-server.ts",
        "simple-mongo": "docker run --rm -p 27017:27017 mongo",
        "simple-postgres": "docker run --rm -p 5432:5432 -e POSTGRES_PASSWORD=postgres postgres"
    },
    "dependencies": {
        "@grpc/grpc-js": "~1.8.22",
        "chardet": "~1.4.0",
        "croner": "~8.1.2",
        "dayjs": "~1.11.19",
        "feed": "~4.2.2",
        "gamedig": "~5.3.2",
        "globalping": "~0.2.0",
        "iconv-lite": "~0.6.3",
        "jsonata": "~2.1.0",
        "kafkajs": "~2.2.4",
        "liquidjs": "~10.26.0",
        "marked": "~14.1.4",
        "mongodb": "~4.17.2",
        "mqtt": "~4.3.8",
        "mssql": "~12.0.0",
        "mysql2": "~3.11.5",
        "net-snmp": "~3.26.1",
        "node-cloudflared-tunnel": "~1.0.10",
        "nodemailer": "~7.0.13",
        "nostr-tools": "~2.20.0",
        "oracledb": "~6.10.0",
        "pg": "~8.11.6",
        "pg-connection-string": "~2.6.4",
        "pinia": "^3.0.4",
        "playwright-core": "1.61.0",
        "protobufjs": "~7.2.6",
        "radius": "~1.1.4",
        "redis": "~5.9.0",
        "tldts": "~7.0.23",
        "web-push": "~3.6.7"
    },
    "devDependencies": {
        "@actions/github": "~6.0.1",
        "@playwright/test": "1.61.0",
        "@popperjs/core": "~2.10.2",
        "@testcontainers/hivemq": "^10.28.0",
        "@testcontainers/mssqlserver": "^10.28.0",
        "@testcontainers/mysql": "^11.12.0",
        "@testcontainers/oraclefree": "^11.13.0",
        "@testcontainers/postgresql": "^11.12.0",
        "@testcontainers/rabbitmq": "^10.28.0",
        "@types/bootstrap": "~5.1.13",
        "@types/bun": "^1.3.14",
        "@types/node": "^20.19.33",
        "@types/web-push": "^3.6.4",
        "@vitejs/plugin-vue": "~5.0.5",
        "@vue/compiler-sfc": "~3.4.38",
        "@vuepic/vue-datepicker": "~3.4.8",
        "aedes": "~1.0.0",
        "bootstrap": "5.1.3",
        "chart.js": "~4.2.1",
        "chartjs-adapter-dayjs-4": "~1.0.4",
        "cronstrue": "~2.24.0",
        "dns2": "~2.0.5",
        "dompurify": "~3.4.0",
        "favico.js": "~0.3.10",
        "oxfmt": "^0.56.0",
        "oxlint": "^1.71.0",
        "postcss-html": "~1.8.1",
        "postcss-rtlcss": "~5.7.1",
        "postcss-scss": "~4.0.9",
        "prismjs": "~1.30.0",
        "qrcode": "~1.5.4",
        "rollup-plugin-visualizer": "^5.14.0",
        "sass": "~1.42.1",
        "stylelint": "^15.11.0",
        "stylelint-config-standard": "~25.0.0",
        "testcontainers": "^11.12.0",
        "typescript": "^6.0.3",
        "v-pagination-3": "~0.1.7",
        "vite": "~5.4.21",
        "vite-plugin-compression": "^0.5.1",
        "vue": "~3.5.28",
        "vue-chartjs": "~5.2.0",
        "vue-contenteditable": "~3.0.4",
        "vue-i18n": "~11.2.8",
        "vue-image-crop-upload": "~3.0.3",
        "vue-multiselect": "~3.0.0",
        "vue-prism-editor": "~2.0.0-alpha.2",
        "vue-qrcode": "~1.0.1",
        "vue-router": "~4.2.5",
        "vue-toastification": "~2.0.0-rc.5",
        "vuedraggable": "~4.1.0"
    },
    "allowScripts": {
        "cpu-features@0.0.10": true,
        "protobufjs@7.6.1": true,
        "protobufjs@7.2.6": true,
        "esbuild@0.21.5": true,
        "oracledb@6.10.0": true,
        "ssh2@1.17.0": true,
        "vue-demi@0.12.5": true
    }
}
